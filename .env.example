# Application environment
# IMPORTANT: production is the default. Set APP_ENV=development only for local development.
APP_ENV=production

# Required in production: generate with generate_password_hash.py
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash

# Initial Owner account created automatically only when no users exist.
INITIAL_OWNER_USERNAME=owner
INITIAL_OWNER_NAME=RI BUROM Owner
INITIAL_OWNER_EMAIL=

# Optional development-only fallback. Prefer ADMIN_PASSWORD_HASH even locally.
# ADMIN_PASSWORD=plain-text-development-password

# --- Database ---
# Omit to use local SQLite (riburom.db) during development.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Persistent media storage ---
# In local development leave Cloudinary off; the app uses static/uploads/ instead.
USE_CLOUDINARY=false
# Omit to use local disk in development only.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Rate limiting ---
# memory:// is fine for one local process.
# Use Redis for multiple Gunicorn workers/instances.
RATELIMIT_STORAGE_URI=memory://

# --- New enquiry notifications ---
# Email recipient defaults to INITIAL_OWNER_EMAIL when NOTIFICATION_EMAIL is blank.
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Phone recipient defaults to WHATSAPP_PHONE when NOTIFICATION_PHONE is blank.
NOTIFICATION_PHONE=

# --- Twilio SMS ---
# Optional Twilio SMS sender number (E.164, e.g. +9198xxxxxxxx).
TWILIO_FROM_NUMBER=

# --- Twilio WhatsApp ---
# Production WhatsApp requires a registered WhatsApp sender and an approved
# WhatsApp Content Template. Use the HX... Content SID from Twilio Console.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
